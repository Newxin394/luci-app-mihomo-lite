#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG="/usr/bin/mihomo"
CONF_DIR="/etc/mihomo"
CONF_FILE="$CONF_DIR/config.yaml"
LOG_DIR="/var/log/mihomo"
CORE_LOG="$LOG_DIR/core.log"

# 与原 Nikki 一致的资源限制 / Go 内存上限（nikki.procd.rlimit_nofile_* / env_go_mem_limit）
NODE_LIMIT="65536 65536"
GO_MEM_LIMIT="256MiB"

start_service() {
    local enabled=$(uci -q get mihomo.config.enabled)
    [ "$enabled" = "1" ] || return 0

    mkdir -p "$CONF_DIR" "$LOG_DIR"

    # 等 br-lan 就绪：eBPF 透明代理的 TC 钩子必须挂到网桥上。
    # 网桥没起来就启动的话，mihomo 会「跑起来了但钩子没挂上」——进程活着、透明代理静默失效，
    # 很难发现。这里最多等 15 秒（正常情况下 /sys/class/net/br-lan 一开始就存在，等于不等待）。
    local i=0
    while [ $i -lt 15 ] && [ ! -e /sys/class/net/br-lan ]; do
        sleep 1
        i=$((i + 1))
    done

    if [ ! -s "$CONF_FILE" ]; then
        /usr/share/mihomo/ctl.sh update_sub
    fi
    [ -s "$CONF_FILE" ] || return 1

    procd_open_instance mihomo
    procd_set_param command /bin/sh -c "$PROG -d $CONF_DIR -f $CONF_FILE >> $CORE_LOG 2>&1"
    procd_set_param env GOMEMLIMIT="$GO_MEM_LIMIT"
    procd_set_param respawn 3600 5 5
    procd_set_param file "$CONF_FILE"
    procd_set_param limits nofile="$NODE_LIMIT"
    procd_close_instance
}

stop_service() {
    # 先温和终止：mihomo 正常退出时会自己卸载 br-lan 上的 tcx/eBPF 钩子，
    # 直接用 kill -9 会留下孤立的 tc filter/BPF link，久了会堆积。
    killall mihomo 2>/dev/null
    local i=0
    while [ $i -lt 6 ] && pgrep -f "$PROG.*$CONF_DIR" >/dev/null 2>&1; do
        sleep 1
        i=$((i + 1))
    done
    if pgrep -f "$PROG.*$CONF_DIR" >/dev/null 2>&1; then
        killall -9 mihomo 2>/dev/null
        sleep 1
    fi
    return 0
}

reload_service() {
    local sec=$(uci -q get mihomo.config.api_secret)
    [ -z "$sec" ] && sec="zj88O465"
    local port=$(uci -q get mihomo.config.api_port)
    [ -z "$port" ] && port="9090"

    if pgrep -f "$PROG.*$CONF_DIR" >/dev/null 2>&1; then
        curl -s -o /dev/null -X PUT "http://127.0.0.1:$port/configs?force=true" \
            -H "Authorization: Bearer $sec" \
            -H "Content-Type: application/json" \
            -d "{\"path\": \"$CONF_FILE\"}"
    else
        restart
    fi
}
